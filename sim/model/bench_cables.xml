<!--
  Bench: a harder workcell for the same arm. A drawer, two bins, a raised platform, a socket for a
  peg, and five loose parts. The task that goes with it is in so101sim/tasks.py ("bench").
  Hand-written source; tools/build_model.py copies it into sim/model/ next to the generated robot.

  World frame as in workcell.xml: z up, table top at z = 0, robot base at the origin facing +x.
  Everything the arm has to reach from above is between 0.19 and 0.31 m from the base: closer than
  about 0.20 m it cannot hold its fingers straight down higher than 10 cm, which carrying needs.
  Units: metres, kilograms.

  Layout (top view, robot at the left looking right; y is up the page):

      y +0.24   [red bin]
      y +0.21             (green block)
      y +0.13        <== drawer pulls this way ==  [cabinet, purple cube on its roof, red cube in its drawer]
      y +0.03              (blue cylinder)
      y  0.00   ROBOT
      y -0.02                                       [socket]
      y -0.06            (yellow peg)
      y -0.14                                   [platform]
      y -0.23      [blue bin]
-->
<mujoco model="so101_bench">
  <include file="so101_follower_cables.xml"/>

  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <!-- Contact stiffness: as workcell.xml (the reasons are there). -->
  <default>
    <geom solref="0.004 1" solimp="0.95 0.99 0.001"/>
    <default class="fixture">
      <geom type="box" friction="0.5 0.005 0.0001"/>
    </default>
    <default class="part">
      <geom friction="0.4 0.005 0.0001" condim="4" contype="3"/>
    </default>
  </default>

  <visual>
    <global offwidth="1920" offheight="1080" azimuth="150" elevation="-25"/>
    <headlight ambient="0.25 0.25 0.25" diffuse="0.4 0.4 0.4" specular="0 0 0"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture name="floor" type="2d" builtin="checker" rgb1="0.35 0.35 0.38" rgb2="0.3 0.3 0.33" width="256" height="256"/>
    <material name="floor" texture="floor" texrepeat="8 8" reflectance="0.05"/>
    <material name="table" rgba="0.72 0.6 0.45 1"/>
  </asset>

  <worldbody>
    <light name="key" pos="0.35 -0.35 1.3" dir="-0.2 0.25 -1" diffuse="0.65 0.65 0.62" castshadow="true"/>
    <light name="fill" pos="-0.3 0.45 1.0" dir="0.3 -0.4 -1" diffuse="0.25 0.25 0.27" castshadow="false"/>

    <geom name="floor" type="plane" pos="0 0 -0.75" size="2 2 0.05" material="floor" rgba="0.33 0.33 0.36 1"/>
    <geom name="table" type="box" pos="0.25 0 -0.375" size="0.4 0.45 0.375" material="table" rgba="0.72 0.6 0.45 1"
          friction="0.5 0.005 0.0001" contype="3"/>

    <include file="cameras_world.xml"/>

    <!-- ============ fixtures (fixed to the table) ============ -->

    <!-- Cabinet: a roof on two side walls and a back wall, open at the front (toward the robot).
         Inside: x 0.239 .. 0.315, y 0.089 .. 0.171, 48 mm high. Roof top at z = 0.052. -->
    <body name="cabinet" pos="0.277 0.13 0" childclass="fixture">
      <geom name="cabinet_roof" pos="0 0 0.050" size="0.042 0.045 0.002" rgba="0.45 0.47 0.52 1"/>
      <geom name="cabinet_left" pos="0 0.043 0.024" size="0.042 0.002 0.024" rgba="0.45 0.47 0.52 1"/>
      <geom name="cabinet_right" pos="0 -0.043 0.024" size="0.042 0.002 0.024" rgba="0.45 0.47 0.52 1"/>
      <geom name="cabinet_back" pos="0.040 0 0.024" size="0.002 0.045 0.024" rgba="0.45 0.47 0.52 1"/>

      <!-- Drawer: a tray that slides out toward the robot (-x) by up to 85 mm. It does not rest on the
           table (1 mm clear); its slide has friction, so it stays where it is left. The handle is a
           post on top of the front panel, in front of the cabinet, to be pinched from above. -->
      <body name="drawer" pos="0 0 0">
        <joint name="drawer" type="slide" axis="-1 0 0" range="0 0.085" damping="3" frictionloss="0.5" armature="0.01"/>
        <geom name="drawer_floor" pos="-0.008 0 0.0025" size="0.043 0.038 0.0015" rgba="0.8 0.78 0.7 1" mass="0.010"/>
        <geom name="drawer_left" pos="-0.008 0.0365 0.010" size="0.043 0.0015 0.006" rgba="0.8 0.78 0.7 1" mass="0.003"/>
        <geom name="drawer_right" pos="-0.008 -0.0365 0.010" size="0.043 0.0015 0.006" rgba="0.8 0.78 0.7 1" mass="0.003"/>
        <geom name="drawer_back" pos="0.0335 0 0.010" size="0.0015 0.038 0.006" rgba="0.8 0.78 0.7 1" mass="0.003"/>
        <geom name="drawer_front" pos="-0.051 0 0.019" size="0.004 0.040 0.018" rgba="0.8 0.78 0.7 1" mass="0.010"/>
        <geom name="drawer_handle" pos="-0.053 0 0.052" size="0.006 0.006 0.015" rgba="0.2 0.2 0.22 1" mass="0.004"
              friction="1.0 0.02 0.0005" condim="4"/>
      </body>
    </body>

    <!-- Bins: four low walls on the table (the table is the bottom). Inside 56 x 56 mm, walls 14 mm high. -->
    <body name="red_bin" pos="0.10 0.24 0" childclass="fixture">
      <geom name="red_bin_n" pos="0 0.0295 0.007" size="0.031 0.0015 0.007" rgba="0.75 0.2 0.2 1"/>
      <geom name="red_bin_s" pos="0 -0.0295 0.007" size="0.031 0.0015 0.007" rgba="0.75 0.2 0.2 1"/>
      <geom name="red_bin_e" pos="0.0295 0 0.007" size="0.0015 0.028 0.007" rgba="0.75 0.2 0.2 1"/>
      <geom name="red_bin_w" pos="-0.0295 0 0.007" size="0.0015 0.028 0.007" rgba="0.75 0.2 0.2 1"/>
    </body>
    <body name="blue_bin" pos="0.13 -0.23 0" childclass="fixture">
      <geom name="blue_bin_n" pos="0 0.0295 0.007" size="0.031 0.0015 0.007" rgba="0.2 0.35 0.8 1"/>
      <geom name="blue_bin_s" pos="0 -0.0295 0.007" size="0.031 0.0015 0.007" rgba="0.2 0.35 0.8 1"/>
      <geom name="blue_bin_e" pos="0.0295 0 0.007" size="0.0015 0.028 0.007" rgba="0.2 0.35 0.8 1"/>
      <geom name="blue_bin_w" pos="-0.0295 0 0.007" size="0.0015 0.028 0.007" rgba="0.2 0.35 0.8 1"/>
    </body>

    <!-- Platform: a solid block, top at z = 0.040, 80 x 80 mm. -->
    <body name="platform" pos="0.27 -0.14 0" childclass="fixture">
      <geom name="platform" pos="0 0 0.020" size="0.040 0.040 0.020" rgba="0.55 0.55 0.6 1"/>
    </body>

    <!-- Socket: a block 56 x 56 x 25 mm with a 26 mm square hole through it, for the 18 mm peg. -->
    <body name="socket" pos="0.30 -0.02 0" childclass="fixture">
      <geom name="socket_n" pos="0 0.0205 0.0125" size="0.028 0.0075 0.0125" rgba="0.85 0.75 0.2 1"/>
      <geom name="socket_s" pos="0 -0.0205 0.0125" size="0.028 0.0075 0.0125" rgba="0.85 0.75 0.2 1"/>
      <geom name="socket_e" pos="0.0205 0 0.0125" size="0.0075 0.013 0.0125" rgba="0.85 0.75 0.2 1"/>
      <geom name="socket_w" pos="-0.0205 0 0.0125" size="0.0075 0.013 0.0125" rgba="0.85 0.75 0.2 1"/>
    </body>

    <!-- ============ loose parts ============ -->
    <!-- In the closed drawer: -->
    <body name="red_cube" pos="0.277 0.13 0.0191" childclass="part">
      <freejoint name="red_cube_free"/>
      <geom name="red_cube" type="box" size="0.015 0.015 0.015" mass="0.03" rgba="0.85 0.2 0.2 1"/>
    </body>
    <!-- On the cabinet's roof: -->
    <body name="purple_cube" pos="0.277 0.13 0.0646" childclass="part">
      <freejoint name="purple_cube_free"/>
      <geom name="purple_cube" type="box" size="0.0125 0.0125 0.0125" mass="0.018" rgba="0.6 0.3 0.8 1"/>
    </body>
    <!-- On the table: -->
    <body name="blue_cylinder" pos="0.22 0.03 0.0301" childclass="part">
      <freejoint name="blue_cylinder_free"/>
      <geom name="blue_cylinder" type="cylinder" size="0.015 0.03" mass="0.025" rgba="0.2 0.4 0.85 1"/>
    </body>
    <body name="yellow_peg" pos="0.21 -0.06 0.0301" childclass="part">
      <freejoint name="yellow_peg_free"/>
      <geom name="yellow_peg" type="cylinder" size="0.009 0.03" mass="0.012" rgba="0.95 0.85 0.15 1"/>
    </body>
    <body name="green_block" pos="0.17 0.21 0.0101" childclass="part">
      <freejoint name="green_block_free"/>
      <geom name="green_block" type="box" size="0.02 0.0125 0.01" mass="0.02" rgba="0.2 0.7 0.3 1"/>
    </body>
  </worldbody>
</mujoco>
