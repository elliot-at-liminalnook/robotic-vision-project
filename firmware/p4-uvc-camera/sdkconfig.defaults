# ESP32-P4 + IMX708 UVC webcam. Board: Waveshare ESP32-P4-WIFI6(-M), P4 rev 1.0.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# PSRAM for frame buffers. 200 MHz is gated behind experimental features;
# without it the speed silently falls back to 20 MHz, too slow for the camera.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_200M=y
# Larger L2 lines = fewer, larger PSRAM transactions for camera DMA, and 128-byte
# aligned buffers (the JPEG encoder corrupts output on misaligned input; see
# esp32-stereo-camera CAMERA-TECHNICAL-REFERENCE section 19).
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# esp_video: MIPI-CSI capture, ISP, hardware JPEG encoder
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
CONFIG_ESP_VIDEO_ENABLE_HW_JPEG_ENC_VIDEO_DEVICE=y

# IMX708 sensor + DW9807 lens motor (autofocus), auto-detected on SCCB
CONFIG_CAMERA_IMX708=y
CONFIG_CAMERA_IMX708_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_IMX219=n
CONFIG_CAM_MOTOR_DW9807=y
CONFIG_CAM_MOTOR_DW9807_AUTO_DETECT=y
CONFIG_ESP_IPA_AF_ALGORITHM=y
CONFIG_ESP_VIDEO_ENABLE_CAMERA_MOTOR_CONTROLLER=y
CONFIG_ESP_VIDEO_ISP_PIPELINE_CONTROL_CAMERA_MOTOR=y

# USB UVC device on the P4's native USB 2.0 High-Speed port (the 4-pin MX1.25
# "USB" header, NOT the USB-C port, which is a CH343 serial bridge).
CONFIG_TINYUSB_RHPORT_HS=y
CONFIG_TUSB_MANUFACTURER="robotic-vision-project"
CONFIG_TUSB_PRODUCT="P4 IMX708 Camera"
# Serial is replaced at runtime with the P4's MAC, so both boards are distinct.
CONFIG_TUSB_SERIAL_NUM="000000000000"
CONFIG_FORMAT_MJPEG_CAM1=y
CONFIG_UVC_MODE_ISOC_CAM1=y
CONFIG_UVC_CAM1_MULTI_FRAMESIZE=y
# Every advertised size must be an IMX708 driver mode (all are centre crops of
# one 2304x1296 binned field; smaller = narrower view, not a downscale).
# The sensor runs ~28 fps; 30 is the nominal UVC rate.
CONFIG_FRAMESIZE_FHD=y
CONFIG_UVC_CAM1_FRAMERATE=30
CONFIG_UVC_MULTI_FRAME_WIDTH_1=1280
CONFIG_UVC_MULTI_FRAME_HEIGHT_1=720
CONFIG_UVC_MULTI_FRAME_FPS_1=30
CONFIG_UVC_MULTI_FRAME_WIDTH_2=800
CONFIG_UVC_MULTI_FRAME_HEIGHT_2=600
CONFIG_UVC_MULTI_FRAME_FPS_2=30
CONFIG_UVC_MULTI_FRAME_WIDTH_3=640
CONFIG_UVC_MULTI_FRAME_HEIGHT_3=480
CONFIG_UVC_MULTI_FRAME_FPS_3=30

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Image options live in "P4 UVC camera" (main/Kconfig.projbuild); defaults are
# auto exposure/focus, no flips, JPEG quality 80. Examples:
# CONFIG_P4CAM_HFLIP=y
# CONFIG_P4CAM_VFLIP=y
# CONFIG_P4CAM_FIXED_EXPOSURE=y
# CONFIG_P4CAM_EXPOSURE_US=10000
# CONFIG_P4CAM_GAIN_INDEX=10
# Fixed focus also needs the autofocus loop's motor control switched off:
# CONFIG_ESP_VIDEO_ISP_PIPELINE_CONTROL_CAMERA_MOTOR=n
# CONFIG_P4CAM_FIXED_FOCUS=y
# CONFIG_P4CAM_FOCUS_POSITION=512
